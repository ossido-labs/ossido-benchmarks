{
  "name": "ossido-benchmark",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "workspaces": ["examples/*"],
  "scripts": {
    "bench": "cargo run --release -p bench -- throughput",
    "bench:build": "cargo run --release -p bench -- build",
    "bench:all": "cargo run --release -p bench -- throughput --build",
    "bench:quick": "BENCH_DURATION=3 BENCH_WARMUP=1 BENCH_CONNECTIONS=20 cargo run --release -p bench -- throughput",
    "bench:memory": "cargo run --release -p bench -- memory",
    "bench:index": "cargo run --release -p bench -- index",
    "bench:version": "cargo run --release -p bench -- version"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
